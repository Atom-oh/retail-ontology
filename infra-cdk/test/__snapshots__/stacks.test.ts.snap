                "arn:aws:bedrock:*::foundation-model/cohere.embed-*",
                "arn:aws:bedrock:*::foundation-model/cohere.rerank-*",
                "arn:aws:bedrock:ap-northeast-2:000000000000:inference-profile/*",
                "arn:aws:bedrock:*:000000000000:inference-profile/*",
                "arn:aws:bedrock:ap-northeast-2::inference-profile/*",
                "arn:aws:bedrock:*::inference-profile/*",
              ],
              "Sid": "BedrockInvokeModels",
            },
            {
              "Action": [
                "bedrock:Retrieve",
                "bedrock:RetrieveAndGenerate",
                "bedrock:ApplyGuardrail",
              ],
              "Effect": "Allow",
              "Resource": [
                "arn:aws:bedrock:ap-northeast-2:000000000000:knowledge-base/*",
                "arn:aws:bedrock:ap-northeast-2:000000000000:guardrail/*",
              ],
              "Sid": "BedrockKBAndGuardrails",
            },
