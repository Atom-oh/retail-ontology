            [
              "{"start":"-PT3H","widgets":[{"type":"text","width":24,"height":1,"x":0,"y":0,"properties":{"markdown":"# ontology-retail-test — Demo Health\\nPre-demo 5-minute checklist (spec § 12.2)"}},{"type":"metric","width":12,"height":6,"x":0,"y":1,"properties":{"view":"timeSeries","title":"A. Search Latency (ms)","region":"",
              {
                "Ref": "AWS::Region",
