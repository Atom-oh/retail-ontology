{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scrub-secrets.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scrub-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/scrub-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/changelog-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(* --require-approval never*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(eval *)",
      "Bash(aws iam delete-user*)",
      "Bash(aws iam delete-role*)",
      "Bash(aws iam create-access-key*)",
      "Bash(aws s3 rb *)",
      "Bash(aws s3api delete-bucket*)",
      "Bash(aws cloudfront delete-distribution*)",
      "Bash(aws cognito-idp delete-user-pool*)",
      "Bash(cdk destroy*)",
      "Bash(npx cdk destroy*)"
    ]
  }
}
